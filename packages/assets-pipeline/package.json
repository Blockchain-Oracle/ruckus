{
  "name": "@arena/assets-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "audio-sprite": "./src/audio-sprite.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "previews": "node src/encode-previews.ts ../../assets-src/hub/previews/raw ../../apps/web/src/assets/previews",
    "chicken": "node src/chicken-character.ts ../../assets-src/chicken/src ../../apps/web/src/assets/models/chicken.glb",
    "audio:hub": "node src/audio-sprite.ts ../../assets-src/hub/ui/sprite.json ../../apps/web/src/assets/audio/hub-ui",
    "chicken:fan": "node src/chicken-fan.ts ../../apps/web/src/assets/models/chicken.glb ../../apps/web/src/assets/models/chicken-fan.glb"
  },
  "devDependencies": {
    "@arena/tsconfig": "workspace:*",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^24.10.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "catalog:"
  }
}
