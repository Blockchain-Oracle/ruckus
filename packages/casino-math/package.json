    "test": "vitest run",
    "vectors": "tsx scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@arena/tsconfig": "workspace:*",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
