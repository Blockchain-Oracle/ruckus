{
  "name": "@arena/casino-math",
  "version": "0.0.0",
  "private": true,
  "description": "TS mirror of RuckusGame's class tables, draw and payout (ADR-001/004). Kept equal to Solidity by parity vectors.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./seedbanks/*": "./seedbanks/*"
  },
  "scripts": {
