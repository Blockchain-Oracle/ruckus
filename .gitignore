casino-sdk/node_modules/
casino-sdk/**/node_modules/
casino-sdk/package-lock.json
casino-sdk/simulator/contracts/*Game.sol
casino-sdk/simulator/.cache/
casino-sdk/simulator/artifacts/
casino-sdk/simulator/cache/

# Dependencies & build output
node_modules/
dist/
build/
.turbo/
*.tsbuildinfo
coverage/

# Rust
target/

# Contracts (Foundry)
contracts/out/
contracts/cache/
contracts/broadcast/

# Raw asset sources whose licences forbid redistribution (e.g. Sonniss WAVs)
assets-src/**/restricted/

# Env & secrets
.env
.env.*
!.env.example
convex/.env.local

# Tooling
.vercel/
playwright-report/
test-results/

# OS / editors
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
.vercel
.env*

# CC0 packs fetched by assets-src/runner/fetch-packs.sh (large; rebuilt locally)
assets-src/runner/packs/

# Raw attract recordings for the landing previews (re-captured with capture-previews)
assets-src/hub/previews/

# AI-agent working files: instructions, session handoffs, scraped inputs and scratch notes.
# They stay on the maintainer's disk; the repo carries only the project and its real docs.
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.claude/
.agents/
.cursor/
.codex/
.windsurf/
.mcp.json
# Working docs (decisions, research, parity notes, credits ledger) stay local; only the README art ships.
docs/*
!docs/assets/
docs/assets/*
!docs/assets/readme/

# Meshy raw downloads (6–8 MB each, textures duplicated per clip). The texture-stripped sources in
# assets-src/chicken/src rebuild the chicken exactly; task ids and prompts are in docs/assets.
assets-src/chicken/models/
