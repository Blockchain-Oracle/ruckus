casino-sdk/node_modules/
casino-sdk/**/node_modules/
casino-sdk/package-lock.json
casino-sdk/simulator/contracts/*Game.sol
casino-sdk/simulator/.cache/
casino-sdk/simulator/artifacts/
casino-sdk/simulator/cache/

# Dependencies & build output
node_modules/
dist/
build/
.turbo/
*.tsbuildinfo
coverage/

# Rust
target/

# Contracts (Foundry)
contracts/out/
contracts/cache/
contracts/broadcast/

# Raw asset sources whose licences forbid redistribution (e.g. Sonniss WAVs)
assets-src/**/restricted/

# Env & secrets
.env
.env.*
!.env.example
convex/.env.local

# Tooling
.vercel/
playwright-report/
test-results/

# OS / editors
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
.vercel
.env*

# CC0 packs fetched by assets-src/runner/fetch-packs.sh (large; rebuilt locally)
assets-src/runner/packs/
